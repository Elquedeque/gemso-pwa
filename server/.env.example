PORT=3000
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gemso_db
# Clave para firmar los tokens de sesión (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
# Notificaciones push (llaves VAPID). Generar una sola vez con:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT es un correo de contacto con "mailto:" al inicio
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sistemas@gemso.com
# Correos (nodemailer). Para pruebas se puede crear una cuenta de Ethereal (los correos no llegan a nadie):
#   node -e "require('nodemailer').createTestAccount().then(a => console.log(a))"
# Para producción: los datos SMTP de la cuenta de la empresa (por ejemplo, Microsoft 365: smtp.office365.com, 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="GEMSO Talento y Cultura <notificaciones@gemso.com>"
# Recordatorios programados para Talento y Cultura (cada hora de 8:00 a 20:00). Poner false para apagarlos
RECORDATORIOS_ACTIVOS=true
